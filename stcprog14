#include <stdio.h>
void increasing(int n) {
if (n == 0) return;
increasing(n - 1); // recurse first ...
printf("%d ", n); // ... print while unwinding
}
void decreasing(int n) {
if (n == 0) return;
printf("%d ", n); // print first ...
decreasing(n - 1); // ... then recurse
}
int main() {
int n;
printf("Enter a number: ");
scanf("%d", &n);
increasing(n);
printf("\n");
decreasing(n);
printf("\n");
return 0;
}
