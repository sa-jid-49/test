#include <stdio.h>
int main() {
int arr1 [2][2] = {1,2,3,4};
int arr2 [2][2] = {5,6,7,8};
int result [2][2];
for(int i=0;i<2;i++){
for(int j=0;j<2;j++){
result[i][j] = arr1[i][j] + arr2[i][j];
}
}
// Display the 2D array
printf("\nThe entered 2D array is:\n");
for (int i = 0; i < 2; i++) {
for (int j = 0; j < 2; j++) {
printf("%d\t", result[i][j]);
}
printf("\n");
}
return 0;
}
