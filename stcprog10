#include <stdio.h>

int main() {
    int n, sum = 0;

    // ব্যবহারকারীর কাছ থেকে n এর মান ইনপুট নেওয়া
    printf("একটি ধনাত্মক পূর্ণসংখ্যা n লিখুন: ");
    scanf("%d", &n);

    // for লুপ ব্যবহার করে ১ থেকে n পর্যন্ত যোগফল বের করা
    for (int i = 1; i <= n; i++) {
        sum += i; // sum = sum + i
    }

    // ফলাফল প্রিন্ট করা
    printf("যোগফল = %d\n", sum);

    return 0;
}
