#include <stdio.h>
#include <math.h> // sqrt এবং pow ফাংশনের জন্য

int main() {
    float x1, y1, x2, y2, distance;

    // প্রথম বিন্দুর স্থানাঙ্ক ইনপুট
    printf("Enter x1 and y1: ");
    scanf("%f %f", &x1, &y1);

    // দ্বিতীয় বিন্দুর স্থানাঙ্ক ইনপুট
    printf("Enter x2 and y2: ");
    scanf("%f %f", &x2, &y2);

    // সূত্র দিয়ে দূরত্ব বের করা
    distance = sqrt(pow(x2 - x1, 2) + pow(y2 - y1, 2));

    // ফলাফল প্রিন্ট করা
    printf("Distance = %.2f\n", distance);

    return 0;
}
