#include <stdio.h>

int main() {
    float x, y;

    // Taking coordinate inputs
    printf("Enter X coordinate: ");
    scanf("%f", &x);
    printf("Enter Y coordinate: ");
    scanf("%f", &y);

    // Checking the quadrant based on X and Y signs
    if (x > 0 && y > 0) {
        printf("Quadrant 1\n");
    } 
    else if (x < 0 && y > 0) {
        printf("2nd Quadrant\n");
    } 
    else if (x < 0 && y < 0) {
        printf("3rd Quadrant\n");
    } 
    else if (x > 0 && y < 0) {
        printf("Quadrant 4\n");
    } 
    else if (x == 0 && y == 0) {
        printf("At the Origin\n");
    } 
    else if (x == 0) {
        printf("On the Y-axis\n");
    } 
    else {
        printf("On the X-axis\n");
    }

    return 0;
}
