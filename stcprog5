#include <stdio.h>
int main(void) {
int i = 10;
/* while loop: condition is false, body does NOT execute */
printf("while loop output: ");
while (i <= 5) {
printf("%d ", i);
i++;
}
printf("(nothing)\n");
/* do-while loop: body executes ONCE before condition is checked */
i = 10;
printf("do-while loop output: ");
do {
printf("%d ", i);
i++;
} while (i <= 5);
printf("\n");
return 0;
}
