#include <stdio.h>
int main() {
int arr[] = {10, 5, 20, 8, 20};
int n = 5;
int max = arr[0];
int secondMax = -1;
// Find max
for(int i = 1; i < n; i++) {
if(arr[i] > max) {
max = arr[i];
}
}
// Find second max
for(int i = 0; i < n; i++) {
if(arr[i] != max && arr[i] > secondMax) {
secondMax = arr[i];
}
}
printf("Second maximum = %d", secondMax);
return 0;
}
